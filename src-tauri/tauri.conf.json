{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PM Center",
  "version": "2.7.6",
  "identifier": "com.httplink.pmcenter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [  
      {
        "title": "PM Center",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "章知涵@Ninniku",
    "copyright": "Copyright (c) 2026 章知涵@Ninniku",
    "shortDescription": "项目管理与渲染工作流工具",
    "longDescription": "PM Center 项目管理与渲染工作流工具。作者：章知涵@Ninniku；联系 QQ：2143178235。",
    "windows": {
      "wix": {
        "language": "zh-CN",
        "fragmentPaths": ["../installer/author.wxs"],
        "componentGroupRefs": ["AuthorSupportGroup"],
        "dialogImagePath": "../installer/dialog.bmp"
      }
    },
    "resources": [
      "resources/plugin-sdk/**/*",
      "resources/plugin-python/windows-x64/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
