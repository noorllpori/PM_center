{
  "schemaVersion": 1,
  "id": "media.scan-and-summarize",
  "name": "扫描并汇总媒体",
  "description": "验证端口与 DAG 合同",
  "version": "1.0.0",
  "trigger": {
    "kind": "manual"
  },
  "nodes": [
    {
      "id": "scan",
      "nodeType": "media.find-files",
      "inputs": {
        "root": {
          "source": "literal",
          "value": "D:/Media"
        }
      },
      "execution": "local",
      "retry": {
        "maxAttempts": 2,
        "delayMs": 5000,
        "backoffMultiplier": 2
      },
      "timeoutMs": 600000
    },
    {
      "id": "summary",
      "nodeType": "media.summarize",
      "execution": "local"
    }
  ],
  "edges": [
    {
      "from": { "node": "scan", "port": "files" },
      "to": { "node": "summary", "port": "files" }
    }
  ],
  "variables": {}
}

