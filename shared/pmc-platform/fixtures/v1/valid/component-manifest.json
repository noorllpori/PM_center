{
  "schemaVersion": 1,
  "id": "media.file-analyzer",
  "name": "媒体文件分析",
  "description": "扫描并汇总媒体文件",
  "version": "1.2.0",
  "apiVersion": "1",
  "runtime": "native-process",
  "role": "service",
  "distribution": "marketplace",
  "uiMode": "contributed",
  "platforms": ["windows-x64"],
  "entry": "bin/windows-x64/media-file-analyzer.exe",
  "capabilities": ["project.files.read"],
  "requiresComponents": [],
  "optionalComponents": [],
  "contributes": {
    "workflowNodes": [
      {
        "id": "media.find-files",
        "command": "find-files",
        "name": "查找媒体文件",
        "inputs": [
          { "name": "root", "type": "directory", "required": true }
        ],
        "outputs": [
          { "name": "files", "type": "file-list", "required": true }
        ]
      },
      {
        "id": "media.summarize",
        "command": "summarize",
        "name": "汇总媒体信息",
        "inputs": [
          { "name": "files", "type": "file-list", "required": true }
        ],
        "outputs": [
          { "name": "summary", "type": "json", "required": true }
        ]
      }
    ],
    "toolActions": [
      {
        "id": "media.analyze-now",
        "command": "analyze-now",
        "name": "立即分析"
      }
    ],
    "widgets": ["media.analysis-summary"],
    "dataSources": ["media.analysis-results"],
    "settingsSections": [
      {
        "id": "media.file-analyzer.general-settings",
        "title": "分析设置",
        "description": "由宿主统一渲染和保存。",
        "scope": "global",
        "order": 100,
        "fields": [
          {
            "id": "parallelism",
            "label": "并行分析数",
            "type": "integer",
            "required": true,
            "defaultValue": 2,
            "minimum": 1,
            "maximum": 8
          },
          {
            "id": "mode",
            "label": "分析模式",
            "type": "enum",
            "defaultValue": "balanced",
            "options": [
              { "value": "balanced", "label": "均衡" },
              { "value": "thorough", "label": "完整" }
            ]
          }
        ]
      }
    ]
  },
  "resources": {
    "maxMemoryMb": 1024,
    "maxParallelism": 2,
    "timeoutMs": 600000
  },
  "publisher": "PM Center"
}
