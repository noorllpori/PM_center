{
  "$id": "https://pm-center.local/schema/v1/presentation-template.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "definitions": {
    "PresentationTemplateKind": {
      "enum": [
        "shell",
        "page",
        "theme"
      ],
      "type": "string"
    },
    "TemplateSlotAccepts": {
      "enum": [
        "active-surface",
        "component-surface",
        "widget",
        "navigation",
        "tabs",
        "toolbar",
        "status"
      ],
      "type": "string"
    },
    "TemplateSlotDefinition": {
      "additionalProperties": true,
      "properties": {
        "accepts": {
          "default": [],
          "items": {
            "$ref": "#/definitions/TemplateSlotAccepts"
          },
          "type": "array"
        },
        "collapseWhenEmpty": {
          "default": true,
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "layout": {
          "allOf": [
            {
              "$ref": "#/definitions/TemplateSlotLayout"
            }
          ],
          "default": "flow"
        },
        "maxHeight": {
          "format": "uint16",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "maxWidth": {
          "format": "uint16",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "minHeight": {
          "format": "uint16",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "minWidth": {
          "format": "uint16",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "multiplicity": {
          "allOf": [
            {
              "$ref": "#/definitions/TemplateSlotMultiplicity"
            }
          ],
          "default": "many"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "TemplateSlotLayout": {
      "enum": [
        "flow",
        "single",
        "stack",
        "tabs"
      ],
      "type": "string"
    },
    "TemplateSlotMultiplicity": {
      "enum": [
        "one",
        "many"
      ],
      "type": "string"
    }
  },
  "properties": {
    "assets": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "baseHtml": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/definitions/PresentationTemplateKind"
    },
    "optionsSchema": true,
    "regions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "format": "uint16",
      "minimum": 0.0,
      "type": "integer"
    },
    "semanticVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "slots": {
      "default": [],
      "items": {
        "$ref": "#/definitions/TemplateSlotDefinition"
      },
      "type": "array"
    },
    "styles": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "schemaVersion",
    "version"
  ],
  "title": "PresentationTemplateDocumentV1",
  "type": "object"
}
