{
  "$id": "https://pm-center.local/schema/v1/package-header.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "definitions": {
    "ContentDigest": {
      "properties": {
        "algorithm": {
          "$ref": "#/definitions/DigestAlgorithm"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "type": "object"
    },
    "DigestAlgorithm": {
      "enum": [
        "blake3",
        "sha256"
      ],
      "type": "string"
    },
    "PackageKind": {
      "enum": [
        "profile",
        "workspace",
        "component-pack",
        "render-pack"
      ],
      "type": "string"
    },
    "PackagePayloadDescriptor": {
      "additionalProperties": true,
      "properties": {
        "digest": {
          "$ref": "#/definitions/ContentDigest"
        },
        "path": {
          "type": "string"
        },
        "sizeBytes": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "path"
      ],
      "type": "object"
    }
  },
  "properties": {
    "createdAt": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "formatVersion": {
      "const": 1,
      "format": "uint16",
      "minimum": 0.0,
      "type": "integer"
    },
    "kind": {
      "$ref": "#/definitions/PackageKind"
    },
    "magic": {
      "const": "PMC_PACKAGE",
      "type": "string"
    },
    "packageId": {
      "type": "string"
    },
    "payload": {
      "$ref": "#/definitions/PackagePayloadDescriptor"
    },
    "producerVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "format": "uint16",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "createdAt",
    "formatVersion",
    "kind",
    "magic",
    "packageId",
    "payload",
    "producerVersion",
    "schemaVersion"
  ],
  "title": "PackageHeaderV1",
  "type": "object"
}
