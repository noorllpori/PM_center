{
  "$id": "https://pm-center.local/schema/v1/component-manifest.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "definitions": {
    "AutomationCapabilityOperation": {
      "enum": [
        "read",
        "write",
        "delete",
        "execute",
        "connect",
        "notify"
      ],
      "type": "string"
    },
    "AutomationCommandContribution": {
      "additionalProperties": true,
      "properties": {
        "capabilityOperation": {
          "allOf": [
            {
              "$ref": "#/definitions/AutomationCapabilityOperation"
            }
          ],
          "default": "execute"
        },
        "command": {
          "type": "string"
        },
        "contextRequirement": {
          "allOf": [
            {
              "$ref": "#/definitions/AutomationContextRequirement"
            }
          ],
          "default": "either"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "executionSemantics": {
          "allOf": [
            {
              "$ref": "#/definitions/AutomationExecutionSemantics"
            }
          ],
          "default": "non-idempotent"
        },
        "id": {
          "type": "string"
        },
        "inputSchema": {
          "default": null
        },
        "maxAttempts": {
          "default": 0,
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxParallelism": {
          "format": "uint16",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "outputSchema": {
          "default": null
        },
        "requiredCapabilities": {
          "default": [],
          "description": "V2-compatible capability set. `required_capability` remains accepted for existing component packages and is treated as a single entry.",
          "items": {
            "$ref": "#/definitions/Capability"
          },
          "type": "array"
        },
        "requiredCapability": {
          "anyOf": [
            {
              "$ref": "#/definitions/Capability"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeoutMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "command",
        "id",
        "name"
      ],
      "type": "object"
    },
    "AutomationContextRequirement": {
      "enum": [
        "global",
        "project-required",
        "either"
      ],
      "type": "string"
    },
    "AutomationEventContribution": {
      "additionalProperties": true,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "id",
        "name"
      ],
      "type": "object"
    },
    "AutomationExecutionSemantics": {
      "enum": [
        "pure",
        "idempotent",
        "non-idempotent"
      ],
      "type": "string"
    },
    "Capability": {
      "enum": [
        "app.profile.read",
        "app.profile.write",
        "app.settings.read",
        "app.settings.write",
        "notification.send",
        "clipboard.read",
        "clipboard.write",
        "filesystem.dialog.open",
        "filesystem.external.read",
        "filesystem.external.write",
        "project.open",
        "project.files.read",
        "project.files.write",
        "project.metadata.read",
        "project.metadata.write",
        "project.storage.read",
        "project.storage.write",
        "project.storage.direct",
        "cache.inspect",
        "cache.maintain",
        "task.run",
        "task.cancel",
        "python.execute",
        "python.packages.manage",
        "process.spawn",
        "network.http.request",
        "network.lan.discover",
        "network.lan.message",
        "network.lan.transfer",
        "network.server.connect",
        "render.inspect",
        "render.queue.read",
        "render.queue.write",
        "render.worker.execute",
        "render.result.commit"
      ],
      "type": "string"
    },
    "ComponentCategory": {
      "enum": [
        "workspace",
        "file-handler",
        "service",
        "automation",
        "appearance",
        "integration",
        "data"
      ],
      "type": "string"
    },
    "ComponentContributions": {
      "additionalProperties": true,
      "properties": {
        "automationCommands": {
          "default": [],
          "items": {
            "$ref": "#/definitions/AutomationCommandContribution"
          },
          "type": "array"
        },
        "automationEvents": {
          "default": [],
          "items": {
            "$ref": "#/definitions/AutomationEventContribution"
          },
          "type": "array"
        },
        "dataSources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fileHandlers": {
          "default": [],
          "items": {
            "$ref": "#/definitions/FileHandlerContribution"
          },
          "type": "array"
        },
        "pageTemplates": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PageTemplateContribution"
          },
          "type": "array"
        },
        "scriptSurfaces": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ScriptSurfaceContribution"
          },
          "type": "array"
        },
        "settingsSections": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ComponentSettingsSection"
          },
          "type": "array"
        },
        "shellTemplates": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ShellTemplateContribution"
          },
          "type": "array"
        },
        "themePresets": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ThemePresetContribution"
          },
          "type": "array"
        },
        "toolActions": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ToolActionContribution"
          },
          "type": "array"
        },
        "uiExtensionPoints": {
          "default": [],
          "items": {
            "$ref": "#/definitions/UiExtensionPointContribution"
          },
          "type": "array"
        },
        "uiExtensions": {
          "default": [],
          "items": {
            "$ref": "#/definitions/UiExtensionContribution"
          },
          "type": "array"
        },
        "widgets": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workflowNodes": {
          "default": [],
          "description": "Frozen compatibility catalog. R11 no longer executes node graphs.",
          "items": {
            "$ref": "#/definitions/WorkflowNodeContribution"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ComponentDependency": {
      "properties": {
        "id": {
          "type": "string"
        },
        "versionRequirement": {
          "default": "*",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "ComponentDistribution": {
      "enum": [
        "local",
        "bundled",
        "marketplace"
      ],
      "type": "string"
    },
    "ComponentResourceLimits": {
      "additionalProperties": true,
      "properties": {
        "maxMemoryMb": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "maxParallelism": {
          "format": "uint16",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "timeoutMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ComponentRole": {
      "enum": [
        "service",
        "feature",
        "data"
      ],
      "type": "string"
    },
    "ComponentRuntime": {
      "enum": [
        "python-action",
        "python-worker",
        "native-process",
        "native-library",
        "data-pack",
        "builtin-rust"
      ],
      "type": "string"
    },
    "ComponentSettingsSection": {
      "additionalProperties": true,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/definitions/SettingsField"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "order": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/definitions/SettingsScope"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope",
        "title"
      ],
      "type": "object"
    },
    "ComponentUiMode": {
      "enum": [
        "none",
        "hosted",
        "contributed"
      ],
      "type": "string"
    },
    "FileHandlerContribution": {
      "additionalProperties": true,
      "description": "A file handler contributed by a component. The host owns the actual intent dispatch; components only declare matching metadata and a stable handler id.",
      "properties": {
        "extensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fileKinds": {
          "default": [
            "file"
          ],
          "description": "Kinds this handler can open. Older manifests default to files only.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "intents": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mimeTypes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "priority": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "workspaceTarget": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "PageTemplateContribution": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "regions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version"
      ],
      "type": "object"
    },
    "PlatformTarget": {
      "enum": [
        "any",
        "windows-x64",
        "windows-arm64"
      ],
      "type": "string"
    },
    "PortDefinition": {
      "additionalProperties": true,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "$ref": "#/definitions/PortValueType"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "type": "object"
    },
    "PortValueType": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "json",
        "path",
        "file",
        "directory",
        "artifact",
        "string-list",
        "file-list"
      ],
      "type": "string"
    },
    "ScriptSurfaceContribution": {
      "additionalProperties": true,
      "properties": {
        "allowedCommands": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "entry": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "placements": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ScriptSurfacePlacement"
          },
          "type": "array"
        }
      },
      "required": [
        "entry",
        "id",
        "name"
      ],
      "type": "object"
    },
    "ScriptSurfacePlacement": {
      "enum": [
        "shell",
        "workspace",
        "dialog",
        "widget"
      ],
      "type": "string"
    },
    "SettingsField": {
      "additionalProperties": true,
      "properties": {
        "defaultValue": true,
        "description": {
          "default": "",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "maximum": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "minimum": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "options": {
          "default": [],
          "items": {
            "$ref": "#/definitions/SettingsOption"
          },
          "type": "array"
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "sensitive": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "$ref": "#/definitions/SettingsFieldType"
        }
      },
      "required": [
        "id",
        "label",
        "type"
      ],
      "type": "object"
    },
    "SettingsFieldType": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "path",
        "file",
        "directory",
        "enum",
        "string-list"
      ],
      "type": "string"
    },
    "SettingsOption": {
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "type": "object"
    },
    "SettingsScope": {
      "enum": [
        "global",
        "project"
      ],
      "type": "string"
    },
    "ShellTemplateContribution": {
      "additionalProperties": true,
      "properties": {
        "adapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "variants": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version"
      ],
      "type": "object"
    },
    "ThemePresetContribution": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tokens": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version"
      ],
      "type": "object"
    },
    "ToolActionContribution": {
      "additionalProperties": true,
      "properties": {
        "command": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "command",
        "id",
        "name"
      ],
      "type": "object"
    },
    "UiExtensionContribution": {
      "additionalProperties": true,
      "description": "Binds a component-owned script surface into an extension point published by one of its declared component dependencies.",
      "properties": {
        "id": {
          "type": "string"
        },
        "mode": {
          "allOf": [
            {
              "$ref": "#/definitions/UiExtensionMode"
            }
          ],
          "default": "insert"
        },
        "order": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "surfaceId": {
          "type": "string"
        },
        "targetComponentId": {
          "type": "string"
        },
        "targetPointId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "surfaceId",
        "targetComponentId",
        "targetPointId"
      ],
      "type": "object"
    },
    "UiExtensionMode": {
      "enum": [
        "insert",
        "replace"
      ],
      "type": "string"
    },
    "UiExtensionMultiplicity": {
      "enum": [
        "one",
        "many"
      ],
      "type": "string"
    },
    "UiExtensionPointContribution": {
      "additionalProperties": true,
      "description": "A host-owned, versioned place where an isolated component surface may be rendered. The target component keeps ownership of layout and context.",
      "properties": {
        "contextSchema": {
          "default": null
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/definitions/UiExtensionPointKind"
            }
          ],
          "default": "slot"
        },
        "maxHeight": {
          "format": "uint16",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "minHeight": {
          "format": "uint16",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "multiplicity": {
          "allOf": [
            {
              "$ref": "#/definitions/UiExtensionMultiplicity"
            }
          ],
          "default": "many"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "UiExtensionPointKind": {
      "enum": [
        "slot",
        "surface"
      ],
      "type": "string"
    },
    "WorkflowNodeContribution": {
      "additionalProperties": true,
      "properties": {
        "command": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "inputs": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PortDefinition"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "$ref": "#/definitions/PortDefinition"
          },
          "type": "array"
        }
      },
      "required": [
        "command",
        "id",
        "name"
      ],
      "type": "object"
    }
  },
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "capabilities": {
      "default": [],
      "items": {
        "$ref": "#/definitions/Capability"
      },
      "type": "array"
    },
    "category": {
      "anyOf": [
        {
          "$ref": "#/definitions/ComponentCategory"
        },
        {
          "type": "null"
        }
      ]
    },
    "contributes": {
      "allOf": [
        {
          "$ref": "#/definitions/ComponentContributions"
        }
      ],
      "default": {
        "automationCommands": [],
        "automationEvents": [],
        "dataSources": [],
        "fileHandlers": [],
        "pageTemplates": [],
        "scriptSurfaces": [],
        "settingsSections": [],
        "shellTemplates": [],
        "themePresets": [],
        "toolActions": [],
        "uiExtensionPoints": [],
        "uiExtensions": [],
        "widgets": [],
        "workflowNodes": []
      }
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "distribution": {
      "allOf": [
        {
          "$ref": "#/definitions/ComponentDistribution"
        }
      ],
      "default": "local"
    },
    "entry": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "optionalComponents": {
      "default": [],
      "items": {
        "$ref": "#/definitions/ComponentDependency"
      },
      "type": "array"
    },
    "platforms": {
      "default": [],
      "items": {
        "$ref": "#/definitions/PlatformTarget"
      },
      "type": "array"
    },
    "publisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "requiresComponents": {
      "default": [],
      "items": {
        "$ref": "#/definitions/ComponentDependency"
      },
      "type": "array"
    },
    "resources": {
      "allOf": [
        {
          "$ref": "#/definitions/ComponentResourceLimits"
        }
      ],
      "default": {}
    },
    "role": {
      "allOf": [
        {
          "$ref": "#/definitions/ComponentRole"
        }
      ],
      "default": "service"
    },
    "runtime": {
      "$ref": "#/definitions/ComponentRuntime"
    },
    "schemaVersion": {
      "const": 1,
      "format": "uint16",
      "minimum": 0.0,
      "type": "integer"
    },
    "tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "uiMode": {
      "allOf": [
        {
          "$ref": "#/definitions/ComponentUiMode"
        }
      ],
      "default": "none"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "id",
    "name",
    "runtime",
    "schemaVersion",
    "version"
  ],
  "title": "ComponentManifestV1",
  "type": "object"
}
